# --- Data (TASK.pdf §10.2) — defaults point at ./data ---
CORPUS_DIR=./data/corpus
MANIFEST_PATH=./data/manifest.json
DB_PATH=./data/veltrix.db
# Today's date as YYYY-MM-DD. Empty = system date.
APP_TODAY=

# --- Ingestion cache (outside ./data; disposable, never committed) ---
CACHE_DIR=./cache

# --- LLM provider ---
# openai | anthropic | gemini (or google) | openrouter | mistral | nvidia
#   gemini/google uses GOOGLE_API_KEY and Gemini's OpenAI-compatible endpoint (no LLM_BASE_URL needed)
#   openrouter uses OPENROUTER_API_KEY and OpenRouter's endpoint; model IDs like openai/gpt-4.1-mini
#   mistral uses MISTRAL_API_KEY and Mistral's endpoint; e.g. mistral-small-latest (free tier: LLM_MAX_CONCURRENCY=1)
#   nvidia uses NVIDIA_API_KEY and needs LLM_BASE_URL
LLM_PROVIDER=openai
# Pin a dated/exact model ID. Required. e.g. gpt-4.1-mini, claude-sonnet-4-5, gemini-2.5-flash
LLM_MODEL=
# Only to override the endpoint, e.g. https://integrate.api.nvidia.com/v1. Empty = provider default.
LLM_BASE_URL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
NVIDIA_API_KEY=
# Max concurrent LLM calls during ingestion (free tiers rate-limit)
LLM_MAX_CONCURRENCY=4
# Per-call timeout in seconds (each /chat must finish within 30 s, §9.1)
LLM_TIMEOUT_SECONDS=12
# reasoning_effort for OpenAI-compatible reasoning models (gpt-oss: low = ~8 s instead of ~54 s per call). Empty = not sent.
LLM_REASONING_EFFORT=
# Total ingestion time budget; fact extraction stops waiting before it so /health is 200 within 10 min.
INGESTION_BUDGET_SECONDS=480
# Time budget for the LLM calls of one /chat request (the spec allows 30 s; keep a margin).
REQUEST_BUDGET_SECONDS=25

# --- OCR ---
# Tesseract is primary. Optional vision fallback for low-confidence pages; empty = disabled.
# Vision model for scanned pages (OpenAI-compatible providers: openai, gemini, nvidia). Empty = Tesseract only.
# Exact ID from the provider's /v1/models, e.g. meta/llama-3.2-90b-vision-instruct on NVIDIA.
VISION_MODEL=
OCR_MIN_CONFIDENCE=70
# Full path to tesseract if it is not on PATH (Windows installs). Empty in Docker.
TESSERACT_CMD=

# --- Retrieval / rule extraction ---
# local = fastembed bge-small (CPU) | openai = text-embedding-3-small (needs OPENAI_API_KEY)
EMBEDDING_PROVIDER=local
# Rule-key clustering cosine distance. Empty = 0.12, measured on the corpus (docs/DECISIONS_QA.md).
RULE_CLUSTER_THRESHOLD=

# --- Logging ---
LOG_LEVEL=INFO
# json (default) | text (local reading)
LOG_FORMAT=json
